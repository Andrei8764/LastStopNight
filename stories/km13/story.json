  "blocks": [
    {
      "id": "km.start",
      "title": "Tura de noapte",
      "text": "Ultimul client a plecat la 11. De atunci sunt doar eu, radioul și congelatorul care bâzâie ca un frigider cu anxietate.\n\nBenzinăria de la kilometrul 13 nu e pe nicio hartă online. Șeful zice că e mai bine așa. Șeful zice multe.",
      "location": "store",
      "time": "23:40",
      "mood": "normal",
      "fx": [],
      "characters": [],
      "examine": [],
      "decisions": [
        {
          "text": "Dă mai tare la radio",
          "target": "km.radio1",
          "effects": [
            {
              "key": "story.radio",
              "op": "set",
              "value": 1
