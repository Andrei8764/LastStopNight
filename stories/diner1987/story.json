  "blocks": [
    {
      "id": "d87.start",
      "title": "Prima zi",
      "text": "Octombrie 1987. Am 19 ani, o Dacie roșie cu ușa din dreapta legată cu sârmă și un anunț decupat din ziar: \"Ospătar, tura de noapte, plata foarte bună\".\n\nProprietarul mă așteaptă în ușă. Șapca trasă pe ochi, șorț alb, mâini mari. \"Tu ești băiatul nou. Intră, că se răcește cafeaua.\"",
      "location": "exterior",
      "time": "21:30",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "owner",
          "x": 203,
          "facingLeft": true
        }
      ],
      "examine": [],
      "decisions": [
        {
          "text": "Intră după el",
          "target": "d87.contract",
          "effects": [],
          "hotspotY": 110,
          "hotspotX": 203
        }
      ],
      "props": [],
      "lights": [],
      "chapter": "1987: Prima zi",
      "playerX": 262,
      "companionText": {
        "lucia": "Lângă Dacie așteaptă o fată cu părul cârlionțat și o geantă prea mare: Lucia, angajată tot azi, tot din anunț. \"Tu ești Dan? Super. Măcar nu sunt singura nouă.\""
      }
    },
    {
      "id": "d87.contract",
      "title": "Contractul",
      "text": "În birou mirosul de hârtie e nou, nu vechi. Pe perete nu e încă nicio poză. Proprietarul pune în fața mea un contract și un pix.\n\n\"Semnezi aici. Cu numele întreg. Restaurantul ține minte numele.\"",
      "location": "office87",
      "time": "21:40",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "owner",
          "x": 180,
          "facingLeft": true
        }
      ],
      "examine": [],
      "decisions": [
        {
          "text": "Semnează repede",
          "target": "d87.shift",
          "effects": [
            {
              "key": "story.signed",
              "op": "set",
              "value": 1
            }
          ]
        },
        {
          "text": "Citește tot, inclusiv scrisul mic",
          "target": "d87.fineprint",
          "effects": [
            {
              "key": "story.clues",
              "op": "add",
              "value": 1
            }
          ]
        }
      ],
      "props": [],
      "lights": [],
      "playerX": 110,
      "closeup": "images/closeups/contract.png",
      "companionText": {
        "lucia": "Lucia semnează înaintea mea, repede, fără să citească. Proprietarul se uită la semnătura ei și zâmbește."
      }
    },
    {
      "id": "d87.fineprint",
      "title": "Scrisul mic",
      "text": "Clauza 13, scrisă atât de mic încât trebuie să mă aplec: \"Angajatul rămâne în serviciul restaurantului până când acesta găsește un înlocuitor cu același nume.\"\n\nProprietarul nu zice nimic. Doar bate cu degetul în masă. Tic. Tic. Tic.",
      "location": "office87",
      "time": "21:45",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "owner",
          "x": 180,
          "facingLeft": true
        }
      ],
      "examine": [],
      "decisions": [
        {
          "text": "Semnează oricum, ai nevoie de bani",
          "target": "d87.shift",
          "effects": [
            {
              "key": "story.signed",
              "op": "set",
              "value": 1
            },
            {
              "key": "player.nerve",
              "op": "add",
              "value": -10
            }
          ]
        },
        {
          "text": "Semnează cu alt nume",
          "target": "d87.shift",
          "effects": [
            {
              "key": "story.signed",
              "op": "set",
              "value": 1
            },
            {
              "key": "story.fakeName",
              "op": "set",
              "value": 1
            }
          ]
        },
        {
          "text": "Pune pixul jos și pleacă",
          "target": "d87.end.road",
          "effects": []
        }
      ],
      "props": [],
      "lights": [],
      "playerX": 110
    },
    {
      "id": "d87.shift",
      "title": "Sala plină",
      "text": "La 11 sala e plină. Camionagii, o pereche care dansează lângă tonomat, fum de țigară. Proprietarul stă la tejghea și glumește cu o femeie într-o rochie roșie. Ea râde și îmi face cu ochiul.\n\nNimeni nu pare să se teamă de nimic. Asta mă sperie un pic.",
      "location": "dining",
      "time": "23:00",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "patron",
          "x": 70,
          "facingLeft": false
        },
        {
          "id": "owner",
          "x": 268,
          "facingLeft": true
        },
        {
          "id": "red_woman",
          "x": 236,
          "facingLeft": false
        },
        {
          "id": "dancer_m",
          "x": 146,
          "facingLeft": false
        },
        {
          "id": "dancer_f",
          "x": 162,
          "facingLeft": true
        }
      ],
      "examine": [
        {
          "id": "d87.woman",
          "x": 236,
          "label": "Femeia în roșu",
          "text": "\"Ești nou\", zice. \"Pari de treabă. Ascultă-mă: nu-l lăsa să-ți facă poză.\" Apoi râde, ca și cum ar fi fost o glumă.",
          "effects": [
            {
              "key": "story.clues",
              "op": "add",
              "value": 1
            }
          ],
          "once": true,
          "hidden": false,
          "textBy": {
            "lucia": "Femeia în roșu se uită la Lucia: \"Tu ai ochi de om care pleacă la timp. Pleacă la timp, puiule.\""
          }
        },
        {
          "id": "d87.trucker",
          "x": 70,
          "label": "Camionagiul",
          "text": "\"Vin aici de zece ani\", zice. \"Ospătarii se schimbă. Patronul niciodată. Nici măcar nu îmbătrânește, ce zici de asta?\"",
          "effects": [
            {
              "key": "inventory.money",
              "op": "add",
              "value": 5
            }
          ],
          "once": true,
          "hidden": false,
          "textBy": {
            "lucia": "Camionagiul îi face cu ochiul Luciei: \"Să nu te lași pozată, auzi?\""
          }
        }
      ],
      "decisions": [
        {
          "text": "Servește cafea la toată lumea",
          "target": "d87.night",
          "effects": [
            {
              "key": "inventory.money",
              "op": "add",
              "value": 12
            }
          ]
        },
        {
          "text": "Uită-te în geam la toată sala",
          "target": "d87.mirror",
          "effects": [
            {
              "key": "story.clues",
              "op": "add",
              "value": 1
            }
          ],
          "hotspotY": 60,
          "hotspotX": 120
        }
      ],
      "props": [],
      "lights": [],
      "playerX": 40,
      "companionText": {
        "lucia": "Lucia dansează cu tava printre mese. Camionagiii o adoră deja."
      }
    },
    {
      "id": "d87.mirror",
      "title": "Geamul",
      "text": "În geam se văd toți: camionagiul, perechea, femeia în roșu, eu cu tava. Proprietarul nu.\n\nMă întorc. El e acolo, la tejghea, și se uită fix la mine. Își duce un deget la buze.",
      "location": "dining",
      "time": "23:20",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "patron",
          "x": 70,
          "facingLeft": false
        },
        {
          "id": "owner",
          "x": 268,
          "facingLeft": true
        },
        {
          "id": "red_woman",
          "x": 236,
          "facingLeft": false
        },
        {
          "id": "dancer_m",
          "x": 146,
          "facingLeft": false
        },
        {
          "id": "dancer_f",
          "x": 162,
          "facingLeft": true
        }
      ],
      "examine": [],
      "decisions": [
        {
          "text": "Fă-te că n-ai văzut nimic",
          "target": "d87.night",
          "effects": [
            {
              "key": "player.nerve",
              "op": "add",
              "value": -15
            }
          ]
        }
      ],
      "props": [],
      "lights": [],
      "playerX": 120
    },
    {
      "id": "d87.night",
      "title": "Registrul",
      "text": "Pe la 2, în bucătărie, proprietarul scrie ceva într-un registru gros, legat în piele. Un brad pe copertă.\n\n\"Reguli\", zice fără să ridice ochii. \"Pentru cei care vin după tine. Restaurantul are nevoie de cineva care să-l țină minte.\"",
      "location": "kitchen",
      "time": "02:00",
      "mood": "sepia",
      "fx": [],
      "characters": [
        {
          "id": "owner",
          "x": 200,
          "facingLeft": true
        }
      ],
      "examine": [],
      "decisions": [
        {
          "text": "Întreabă-l pentru cine",
          "target": "d87.why",
          "effects": []
        },
        {
          "text": "Rupe ultima pagină cât nu se uită",
          "target": "d87.page",
          "effects": [
            {
              "key": "story.page",
              "op": "set",
              "value": 1
            },
            {
              "key": "story.clues",
              "op": "add",
              "value": 1
            }
          ],
          "hotspotX": 190
        },
        {
          "text": "Lucia îl ține de vorbă, tu citești registrul",
          "target": "d87.lucia",
          "effects": [
            {
              "key": "story.clues",
              "op": "add",
              "value": 1
            }
          ],
          "requiresCharacter": "lucia"
        }
      ],
      "props": [],
      "lights": [],
      "playerX": 60,
      "companionText": {
        "lucia": "Lucia spală pahare și se uită la registru peste umăr, fără să întoarcă capul."
      }
    },
    {
      "id": "d87.lucia",
      "title": "Plăcinta cu afine",
