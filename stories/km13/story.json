      "lights": [],
      "playerX": 90
    },
    {
      "id": "km.girl.mirror",
      "title": "În geam",
      "text": "În geam, magazinul e gol. Rafturile, congelatorul, eu. Fetița nu e acolo.\n\nPe sticlă, din interior, cineva a scris cu degetul în aburi: EL SE ÎNTOARCE.",
      "location": "store",
      "time": "01:15",
      "mood": "red",
      "fx": [],
      "characters": [
        {
          "id": "girl",
          "x": 70,
          "facingLeft": false
        }
      ],
      "examine": [],
      "decisions": [
